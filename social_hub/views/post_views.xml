<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="post_view_list" model="ir.ui.view">
        <field name="name">post.view.list</field>
        <field name="model">post.post</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="post_view_form" model="ir.ui.view">
        <field name="name">post.view.form</field>
        <field name="model">post.post</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="user_id"/>
                        <h1>
                            <field name="user_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="media_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="image"/>
                                </list>
                            </field>
                            <field name="comment_ids">
                                <list>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
                <field name="user_id"/>
            </form>
        </field>
    </record>

    <record id="social_post_action" model="ir.actions.act_window">
        <field name="name">Post</field>
        <field name="res_model">post.post</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
